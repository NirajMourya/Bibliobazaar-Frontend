# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Base URL of the BiblioBazaar backend API
REACT_APP_BASE_URL=

# Razorpay publishable key ID used to open the checkout widget (test or live key)
REACT_APP_RAZORPAY_ID=

# Sentry DSN for error tracking (leave empty to disable Sentry)
REACT_APP_SENTRY_DSN=
